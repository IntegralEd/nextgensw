.DS_Store
.netlify/
node_modules/
*.log

# Workspace panel app build output — regenerated every deploy by
# `npm run build:app` (source lives in workspace-app/)
/app/

# Secrets — never commit
.env
.env.*
!.env.example
env.txt
*.env.txt
secrets.txt

# Local-only reference materials (large binaries, working drafts)
# Use a glob (not the dir itself) so we can selectively re-include files.
Reference/*
# …but keep intentionally-shared reference files
!Reference/softr.txt
!Reference/softr-embed.txt
!Reference/softr-website-announcements.html
!Reference/softr-workspace-embed.html
